// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Material {
  id             String           @id @default(cuid())
  nombre         String           @unique
  precioPorLibra Decimal          @db.Decimal(10, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  purchases      Purchase[]
  cargas         MaterialCarga[]
}

model MaterialCarga {
  id             String   @id @default(cuid())
  businessDate   DateTime @db.Date
  materialId     String
  materialNombre String
  libras         Decimal? @db.Decimal(10, 2)
  descripcion    String?
  createdAt      DateTime @default(now())
  material       Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([materialId])
}

model Client {
  id              String                @id @default(cuid())
  nombre          String                @unique
  telefono        String?
  direccion       String?
  rtn             String?
  cuentaBancaria  String?
  notas           String?
  esGeneral       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  purchaseTransactions PurchaseTransaction[]
}

model PurchaseTransaction {
  id           String     @id @default(cuid())
  businessDate DateTime   @db.Date
  clientId     String
  total        Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items        Purchase[]

  @@index([businessDate])
  @@index([clientId])
}

model DailyBalance {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date @unique
  saldoInicial Decimal  @db.Decimal(12, 2)
  saldoActual  Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Purchase {
  id                   String              @id @default(cuid())
  businessDate         DateTime            @db.Date
  materialId           String
  materialNombre       String
  precioPorLibra       Decimal             @db.Decimal(10, 2)
  libras               Decimal             @db.Decimal(10, 2)
  total                Decimal             @db.Decimal(12, 2)
  purchaseTransactionId String?
  createdAt            DateTime            @default(now())
  material             Material            @relation(fields: [materialId], references: [id], onDelete: Restrict)
  purchaseTransaction  PurchaseTransaction? @relation(fields: [purchaseTransactionId], references: [id], onDelete: Cascade)

  @@index([businessDate])
  @@index([purchaseTransactionId])
}

model Sale {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  descripcion  String
  monto        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@index([businessDate])
}

model Expense {
  id              String           @id @default(cuid())
  businessDate    DateTime         @db.Date
  categoria       String
  descripcion     String
  monto           Decimal          @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  employeePayment EmployeePayment?
  employeeAdvance EmployeeAdvance?

  @@index([businessDate])
}

model Employee {
  id            String            @id @default(cuid())
  nombre        String
  puesto        String?
  telefono      String?
  // Pago por día trabajado: base de todo el cálculo de planilla.
  salarioDiario Decimal           @db.Decimal(10, 2)
  fechaIngreso  DateTime          @db.Date
  activo        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  attendances   Attendance[]
  advances      EmployeeAdvance[]
  payments      EmployeePayment[]
}

model Attendance {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  employeeId   String
  horaEntrada  String // HH:MM
  horaSalida   String? // HH:MM
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([businessDate, employeeId])
  @@index([employeeId])
}

model EmployeeAdvance {
  id            String                      @id @default(cuid())
  businessDate  DateTime                    @db.Date
  employeeId    String
  monto        Decimal                     @db.Decimal(12, 2)
  // Cuánto ya se descontó en planillas; nunca supera `monto`.
  montoAplicado Decimal                     @default(0) @db.Decimal(12, 2)
  descripcion   String?
  expenseId     String?                     @unique
  createdAt     DateTime                    @default(now())
  employee      Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  expense       Expense?                    @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  applications  PayrollAdvanceApplication[]

  @@index([employeeId])
  @@index([businessDate])
}

model EmployeePayment {
  id                 String                      @id @default(cuid())
  businessDate       DateTime                    @db.Date
  employeeId         String
  tipo              String // manual | planilla
  monto              Decimal                     @db.Decimal(12, 2)
  descripcion        String?
  periodoInicio      DateTime?                   @db.Date
  periodoFin         DateTime?                   @db.Date
  diasTrabajados     Int?
  subtotal           Decimal?                    @db.Decimal(12, 2)
  adelantosAplicados Decimal?                    @db.Decimal(12, 2)
  expenseId          String?                     @unique
  createdAt          DateTime                    @default(now())
  employee           Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  expense            Expense?                    @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  applications       PayrollAdvanceApplication[]

  // Una sola planilla por empleado y semana (los pagos manuales llevan periodoInicio NULL).
  @@unique([employeeId, tipo, periodoInicio])
  @@index([businessDate])
}

// Cuánto de un adelanto descontó una planilla concreta; permite revertir el pago.
model PayrollAdvanceApplication {
  id        String          @id @default(cuid())
  paymentId String
  advanceId String
  monto     Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now())
  payment   EmployeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  advance   EmployeeAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, advanceId])
  @@index([advanceId])
}

model CompanySettings {
  id          String   @id @default("singleton")
  nombre      String   @default("")
  rtn         String   @default("")
  telefono    String   @default("")
  direccion   String   @default("")
  email       String   @default("")
  printerIp   String   @default("")
  printerPort Int      @default(9100)
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  userId    String   @unique
  nombre    String   @default("")
  password  String
  role      String   @default("viewer")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrintJob {
  id          String   @id @default(cuid())
  status      String   @default("pending") // pending | claimed | done | error
  printerIp   String
  printerPort Int
  payloadB64  String
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model SyncEvent {
  id        String   @id @default(cuid())
  source    String
  entity    String
  entityId  String
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
